__pycache__/
.DS_Store
.venv/
.playwright-cli/
# STLs are regenerated by the scripts (see geometry/README.md); only the ones to print are kept
*.stl
!geometry/out/moulds/pick_1_rounded_rim_mould_half.stl
!geometry/out/moulds/pick_1_mould_half.stl
!geometry/out/moulds/control_smooth_ring_mould_half.stl
!geometry/out/moulds/crush_test_disc_mould_half.stl
!geometry/out/ga2/B_narrowest_25mm/pick_1_mould_half.stl
!geometry/out/ga2_mix*/*/pick_1_mould_half.stl
!geometry/out/ga2_mixB/*/disc_version_mould_half.stl
!geometry/out/print/*.stl
